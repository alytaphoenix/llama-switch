# halogen-flash-server env for valhalla HALOGEN mode (exclusive).
# Deployed to ~/valhalla/etc/halogen.env by scripts/deploy.sh.
# Used by scripts/mode.sh via podman/docker --env-file.

# Weights repo (server fetches exactly these files into the mounted /models dir)
HALOGEN_DOWNLOAD=peonist-ai/halogen-qwen3.8-flash-next

# Accuracy-first tuning: bigger sparse-attention indexer budget improves
# long-context retrieval (halogen measured 2 planted facts at 16k recovered at
# 4096 vs missed at default 2048) for ~7% prefill cost at 32k.
HALOGEN_INDEXER_BUDGET=4096

# Vision tower optional; harmless for text-only use (byte-identical otherwise).
HALOGEN_VISION_TOWER=1

# Composable context preview: reuses kept tool results after compaction.
# NOT byte-identical (accuracy guarantee off) — leave OFF for accuracy-first,
# flip to 1 for max agentic throughput if benchmarks show it's worth it.
# HALOGEN_COMPOSABLE_CONTEXT=1

# Context budget (match your existing setup's 256k ambition)
HALOGEN_CTX=262144
HALOGEN_MAX_TOKENS_CAP=65536
HALOGEN_KV_SLOTS=4
HALOGEN_PREFILL_CHUNK=32768
HALOGEN_PROMPT_CACHE=2
HALOGEN_QUEUE_TIMEOUT=3600
